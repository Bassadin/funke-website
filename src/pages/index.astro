---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = {
    title: 'FunkeLab — Makerspace in Karlsruhe-Nordweststadt',
    ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
    <Hero>
        <Fragment slot="title">
            Offener <span class="text-accent">Makerspace</span> in Karlsruhe-Nordweststadt
        </Fragment>

        <Fragment slot="subtitle">
            <span class="hidden sm:inline">
                Das <span class="font-bold">FunkeLab</span> ist ein Makerspace in der Karlsruher Nordweststadt.</span
            >
        </Fragment>
    </Hero>

    <Content>
        <Fragment slot="content">
            Wir bieten verschiedene Geräte und Werkzeuge und Platz, um gemeinsam oder allein an Projekten zu arbeiten,
            Ideen auszutauschen und voneinander zu lernen.
        </Fragment>
    </Content>
</Layout>
