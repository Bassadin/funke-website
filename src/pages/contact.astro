---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
    title: 'Contact',
};
---

<Layout metadata={metadata}>
    <!-- HeroText Widget ******************* -->

    <HeroText title="Kontaktmöglichkeiten" />

    <Features2
        title="Finde uns hier..."
        items={[
            {
                title: 'Adresse',
                description: `Stresemannstraße 28, 76187 Karlsruhe`,
                icon: 'tabler:map-pin',
                callToAction: {
                    text: 'Karte öffnen',
                    href: 'https://www.openstreetmap.org/search?query=Stresemannstra%C3%9Fe%2028%2C%2076187%20Karlsruhe',
                },
            },
            {
                title: 'Instagram',
                description: `Instagram-Profil des Funke Vereins`,
                icon: 'tabler:brand-instagram',
                callToAction: {
                    text: 'Profil öffnen',
                    href: 'https://www.instagram.com/die.fffunke',
                },
            },
            {
                title: 'Mastodon',
                description: `Mastodon-Profil des FunkeLab`,
                icon: 'tabler:brand-mastodon',
                callToAction: {
                    text: 'Profil öffnen',
                    href: 'https://mastodon.social/@FunkeLab',
                },
            },
            {
                title: 'Telegram',
                description: `Chatgruppe für Mitglieder und Interessierte`,
                icon: 'tabler:brand-telegram',
                callToAction: {
                    text: 'Jetzt beitreten',
                    href: 'https://t.me/+IfTtCOFWW11kNGE0',
                },
            },
        ]}
    />
</Layout>
